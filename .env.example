# Copie para a Vercel em Settings → Environment Variables. NUNCA coloque valores reais no Git.

# Redis (Upstash) — preenchidas automaticamente ao conectar o banco em Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sessão: texto aleatório com 32+ caracteres (ex.: gerado por um gerenciador de senhas)
SESSION_SECRET=

# Primeiro dono (usado só no primeiro login, quando ainda não há membros)
ADMIN_EMAIL=matheus@denvercontabil.com.br
ADMIN_SENHA=
ADMIN_NOME=Matheus Bortolansa

# Monday (botão "Buscar fundos novos no Monday") — opcional
# Token pessoal: no Monday, foto do perfil → Developers → My access tokens
MONDAY_TOKEN=

# Microsoft (Outlook e Teams na Caixa de entrada) — opcional
MS_CLIENT_ID=
MS_TENANT_ID=

# Slack (Caixa de entrada) — opcional
SLACK_TOKEN=
SLACK_CANAIS=C08BRNPQGSE,C08CMGGLDUN,C0697HS2KS8,C08BKLUSUM9
